# Copy to .env and fill in. Never commit the real .env — it holds live keys.
#   cp .env.example .env && chmod 600 .env

# --- Database ---------------------------------------------------------------
# Local dev uses a file in the project. In production point this OUTSIDE the
# app directory so a redeploy can never overwrite it.
#   production: file:/var/lib/snapcast/snapcast.db
DATABASE_URL="file:./dev.db"

# --- AI (required for real captions) ----------------------------------------
# Without this, captions fall back to generic placeholder text and scores are
# all 50. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Licensed music (optional) ----------------------------------------------
# Without this, clips are tagged with a chosen track but no audio is mixed in.
# Epidemic Sound Partner API key (starts with epidemic_live_).
EPIDEMIC_SOUND_API_KEY=

# --- Media storage ----------------------------------------------------------
# "local" writes to public/uploads on disk — fine for a single server.
# Switch to "s3" (works with Cloudflare R2 too) when you outgrow one box.
STORAGE_PROVIDER=local
STORAGE_S3_BUCKET=
STORAGE_S3_PUBLIC_URL=
# R2: set this to the account endpoint. Real AWS S3: leave blank.
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=

# --- ffmpeg (optional overrides) --------------------------------------------
# Auto-detected on both Windows and Linux; set only if it lives somewhere odd.
# FFMPEG_PATH=/usr/bin/ffmpeg
# Font used for burned-in captions on clips.
# DRAWTEXT_FONT_FILE=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf

# --- Runtime ----------------------------------------------------------------
NODE_ENV=production
PORT=3000
